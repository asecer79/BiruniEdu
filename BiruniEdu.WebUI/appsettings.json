{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=UniEduDb;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"

  },

  "CookieAuthOptions": {
    "Name": "Security",
    "LoginPath": "/Auth/Login",
    "LogOutPath": "/Auth/LogOut",
    "AccessDeniedPath": "/Auth/Err",
    "SlidingExpiration": true,
    "TimeOut": 300 //saniye
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
